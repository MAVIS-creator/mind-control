VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_EMAIL_CONFIRM_REDIRECT_URL=
VITE_PASSWORD_RESET_REDIRECT_URL=
VITE_ADMIN_USERNAMES=Mavis

# Supabase Edge Function secrets for admin-send-email.
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=youraddress@gmail.com
# SMTP_PASSWORD=your_google_app_password
# SMTP_FROM_EMAIL=youraddress@gmail.com
# SMTP_FROM_NAME=MindGrid
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MindGrid

# Server-only Groq API key for future admin AI helpers.
# Do not prefix this with VITE_ or it will be exposed to the browser.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
